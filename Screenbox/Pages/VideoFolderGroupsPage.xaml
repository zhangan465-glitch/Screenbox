<Page
    x:Class="Screenbox.Pages.VideoFolderGroupsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:Screenbox.Behaviors"
    xmlns:commands="using:Screenbox.Commands"
    xmlns:controls="using:Screenbox.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:Screenbox.Helpers"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:sbuc="using:Screenbox.UI.Controls"
    xmlns:strings="using:Screenbox.Strings"
    xmlns:templates="using:Screenbox.Templates"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:viewModels="using:Screenbox.Core.ViewModels"
    SizeChanged="Page_OnSizeChanged"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <templates:GridViewItemTemplates />
            </ResourceDictionary.MergedDictionaries>

            <Thickness x:Key="FolderGroupHeaderMargin">4,0,4,8</Thickness>
            <Thickness x:Key="FolderGroupSectionMargin">0,0,0,24</Thickness>
            <Thickness x:Key="FolderGroupHeaderPadding">8,6</Thickness>
            <Thickness x:Key="FolderGroupEmptyMargin">8,8,8,16</Thickness>

            <Style
                x:Key="FolderGroupHeaderButtonStyle"
                BasedOn="{StaticResource SubtleButtonStyle}"
                TargetType="Button">
                <Setter Property="Padding" Value="{StaticResource FolderGroupHeaderPadding}" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>

            <Style x:Key="FolderGroupListViewItemStyle" TargetType="ListViewItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="{StaticResource FolderGroupSectionMargin}" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                            <ContentPresenter
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <muxc:ProgressBar
            VerticalAlignment="Top"
            IsIndeterminate="True"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

        <ListView
            x:Name="FolderGroups"
            Margin="{StaticResource TopLargeMargin}"
            Padding="{StaticResource GridViewContentPagePadding}"
            ui:ScrollViewerExtensions.VerticalScrollBarMargin="{x:Bind Common.ScrollBarMargin, Mode=OneWay}"
            ItemContainerStyle="{StaticResource FolderGroupListViewItemStyle}"
            ItemsSource="{x:Bind ViewModel.Groups, Mode=OneWay}"
            Loaded="FolderGroups_OnLoaded"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="viewModels:VideoFolderGroupViewModel">
                    <StackPanel>
                        <Grid Margin="{StaticResource FolderGroupHeaderMargin}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button
                                Grid.Column="0"
                                AutomationProperties.Name="{x:Bind Name, Mode=OneWay}"
                                Command="{x:Bind OpenCommand}"
                                IsEnabled="{x:Bind IsAvailable, Mode=OneWay}"
                                Style="{StaticResource FolderGroupHeaderButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon
                                        Grid.Column="0"
                                        Margin="0,0,12,0"
                                        VerticalAlignment="Center"
                                        AutomationProperties.AccessibilityView="Raw"
                                        FontFamily="{StaticResource ScreenboxSymbolThemeFontFamily}"
                                        Glyph="{StaticResource FolderGlyph}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock
                                            AutomationProperties.HeadingLevel="Level2"
                                            MaxLines="1"
                                            Style="{StaticResource SubtitleTextBlockStyle}"
                                            Text="{x:Bind Name, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Grid.Column="0"
                                                Margin="0,2,16,0"
                                                Opacity="{ThemeResource TextFillColorTertiaryOpacity}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind Path, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Margin="0,2,0,0"
                                                Opacity="{ThemeResource TextFillColorTertiaryOpacity}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind strings:Resources.ItemsCount(VideoCount), Mode=OneWay}"
                                                Visibility="{x:Bind IsAvailable, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Margin="0,2,0,0"
                                                Opacity="{ThemeResource TextFillColorTertiaryOpacity}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind strings:Resources.FolderUnavailable}"
                                                Visibility="{x:Bind IsAvailable, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=true, Mode=OneWay}" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <Button
                                Grid.Column="1"
                                Width="40"
                                Height="40"
                                Margin="8,4,0,0"
                                Padding="0"
                                VerticalAlignment="Top"
                                AutomationProperties.Name="{x:Bind helpers:ItemLabelHelper.FormatAccessibleName(Name, strings:Resources.Play), Mode=OneWay}"
                                Command="{x:Bind PlayAllCommand}"
                                Style="{StaticResource SubtleButtonStyle}"
                                ToolTipService.ToolTip="{x:Bind strings:Resources.Play}">
                                <FontIcon FontFamily="{StaticResource ScreenboxSymbolThemeFontFamily}" Glyph="{StaticResource PlayGlyph}" />
                            </Button>
                        </Grid>

                        <GridView
                            ui:ListViewExtensions.Command="{x:Bind PlayCommand}"
                            IsEnabled="{x:Bind IsAvailable, Mode=OneWay}"
                            IsItemClickEnabled="True"
                            ItemContainerStyle="{StaticResource GridViewItemMediaCardStyle}"
                            ItemTemplate="{StaticResource WideMediaGridViewItemTemplate}"
                            ItemsSource="{x:Bind PreviewVideos, Mode=OneWay}"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.HorizontalScrollMode="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollMode="Disabled"
                            SelectionMode="None"
                            Visibility="{x:Bind HasVideos, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                            <GridView.Resources>
                                <commands:BindableCommand x:Key="MediaListViewItemPlayCommand" Command="{x:Bind PlayCommand}" />
                            </GridView.Resources>
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid MaximumRowsOrColumns="1" Orientation="Vertical" />
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                            <interactivity:Interaction.Behaviors>
                                <behaviors:ThumbnailGridViewBehavior />
                            </interactivity:Interaction.Behaviors>
                        </GridView>

                        <TextBlock
                            Margin="{StaticResource FolderGroupEmptyMargin}"
                            Opacity="{ThemeResource TextFillColorSecondaryOpacity}"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{x:Bind strings:Resources.EmptyFolder}"
                            Visibility="{x:Bind HasVideos, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=true, Mode=OneWay}" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.Footer>
                <Border Height="{x:Bind Common.FooterBottomPaddingHeight, Mode=OneWay}" />
            </ListView.Footer>
            <interactivity:Interaction.Behaviors>
                <behaviors:AutoFocusBehavior />
                <behaviors:BringIntoViewWithOffsetBehavior FromBottom="{x:Bind Common.FooterBottomPaddingHeight, Mode=OneWay}" />
            </interactivity:Interaction.Behaviors>
        </ListView>

        <sbuc:ContentUnavailableView
            Margin="{StaticResource TopLargeMargin}"
            Padding="{StaticResource ContentPagePadding}"
            VerticalAlignment="Top"
            IsOpen="{x:Bind ViewModel.IsEmpty, Mode=OneWay}"
            Message="{x:Bind strings:Resources.NoVideosPanelSubtext}" />

        <interactivity:Interaction.Behaviors>
            <behaviors:GamepadXYNavigationBehavior />
        </interactivity:Interaction.Behaviors>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="NavigationViewStates">
                <VisualState x:Name="Expanded" />
                <VisualState x:Name="Compact" />
                <VisualState x:Name="Minimal">
                    <VisualState.StateTriggers>
                        <ui:IsEqualStateTrigger Value="{x:Bind Common.NavigationViewDisplayMode, Mode=OneWay}" To="{StaticResource MinimalNavigationViewDisplayMode}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="FolderGroups.Padding" Value="{StaticResource GridViewContentPageMinimalPadding}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Page>
